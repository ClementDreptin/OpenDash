  <Target Name="CopyFonts" BeforeTargets="DeployToHardDrive">
    <ItemGroup>
      <Fonts Include="src\assets\fonts\**\*.ttf" />
    </ItemGroup>
    <Copy
      SourceFiles="@(Fonts)"
      DestinationFiles="@(Fonts->'$(OutDir)assets\fonts\%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
    />
  </Target>
  <Target Name="CopyImages" BeforeTargets="DeployToHardDrive">
    <ItemGroup>
      <Images Include="src\assets\images\**\*.png" />
    </ItemGroup>
    <Copy
      SourceFiles="@(Images)"
      DestinationFiles="@(Images->'$(OutDir)assets\images\%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
    />
  </Target>
  <Target
    Name="BuildNxeart"
    BeforeTargets="DeployToHardDrive"
    Inputs="$(SolutionDir)xlast/icon-64x64.png;$(SolutionDir)xlast/icon-420x320.jpg;$(SolutionDir)xlast/icon-1920x1080.jpg;$(SolutionDir)xlast/nxeart.xlast"
    Outputs="$(OutDir)nxeart"
  >
    <Exec Command="powershell $(SolutionDir)scripts\build-nxeart.ps1 $(Configuration)" />
  </Target>
</Project>